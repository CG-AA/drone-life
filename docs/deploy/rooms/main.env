# /etc/drone-life.d/main.env — the big room: / on the proxy, the 64-seat siege.
# Read by drone-life@main on top of /etc/drone-life.env (docs/ROOMS.md).
PORT=8000
MAVLINK_BASE_PORT=5760
# the console: loopback only, reach it with ssh -L 8121:127.0.0.1:8121
ADMIN_PORT=8121
MAX_STUDENTS=64
STATE_DIR=state/main
