# /etc/drone-life.d/r1.env — room 1: /r1/ on the proxy. Room i is HTTP 800i,
# MAVLink 5760+100i, 20 seats; `sh docs/deploy/rooms/mkrooms.sh 5` prints all five.
PORT=8001
MAVLINK_BASE_PORT=5860
MAX_STUDENTS=20
STATE_DIR=state/r1
ROOM_LABEL=Room 1
# the projector's join card: this room's tables go straight to /r1/submit.
# Leave it out to show the shared PUBLIC_URL, whose /submit lists every room.
PUBLIC_URL=https://drones.example.org/r1
