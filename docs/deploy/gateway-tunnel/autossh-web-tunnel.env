# Extra variables for autossh-web-tunnel.service.
# APPEND these to /etc/default/autossh-reverse-tunnel (the file already holds
# TUNNEL_KEY and TUNNEL_REMOTE, which this unit reuses). Same BIND/FORWARD
# convention as the ssh tunnel above.

# HTTP: bind ON the gateway's localhost -> this server's port 80.
# Bound to localhost only (not 0.0.0.0), so it is reachable only from the gateway itself.
# 8080 rather than 80 because the `tunneler` user cannot bind ports <1024.
TUNNEL_BIND_HTTP=localhost:8080
TUNNEL_FORWARD_HTTP=localhost:80

# App: bind ON the gateway's localhost -> this server's port 8000.
# Check nothing else on the gateway already uses 8000 (collisions are silent).
TUNNEL_BIND_APP=localhost:8000
TUNNEL_FORWARD_APP=localhost:8000
