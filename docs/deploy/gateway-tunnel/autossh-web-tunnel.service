[Unit]
Description=AutoSSH Reverse Tunnel Service (lamb-server ports 80/8000 -> gateway localhost)
After=network-online.target ssh.service
Wants=network-online.target

[Service]
User=lamb
# Site-specific settings (remote gateway, key path, ports) live in an EnvironmentFile,
# NOT in the repo. This unit shares /etc/default/autossh-reverse-tunnel with
# autossh-reverse-tunnel.service; append the TUNNEL_*_HTTP / TUNNEL_*_APP variables
# from autossh-web-tunnel.env to that file before enabling this unit.
# $TUNNEL_ROOM_FORWARDS is deliberately unbraced: systemd word-splits it into
# one -R per room (docs/ROOMS.md); empty means no extra forwards.
EnvironmentFile=/etc/default/autossh-reverse-tunnel
Environment="AUTOSSH_GATETIME=0"
ExecStart=/usr/bin/autossh -M 0 -N -q \
    -o "ServerAliveInterval 30" -o "ServerAliveCountMax 3" \
    -o ExitOnForwardFailure=yes -o IdentitiesOnly=yes \
    -o BatchMode=yes -o StrictHostKeyChecking=yes \
    -R ${TUNNEL_BIND_HTTP}:${TUNNEL_FORWARD_HTTP} \
    -R ${TUNNEL_BIND_APP}:${TUNNEL_FORWARD_APP} \
    $TUNNEL_ROOM_FORWARDS \
    -i ${TUNNEL_KEY} ${TUNNEL_REMOTE}
Restart=always
RestartSec=10

# --- sandboxing (in-place; no behavioural change) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
